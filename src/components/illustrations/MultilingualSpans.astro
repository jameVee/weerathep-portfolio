---
// Project: SHROOM-Visions — hallucinated spans in a VLM's answers about an image, in four languages.
const rows = [
  { lang: 'EN', y: 30, a: 52, span: [222, 44], b: 30 },
  { lang: 'FR', y: 58, a: 34, span: [204, 52], b: 40 },
  { lang: 'IT', y: 86, a: 70, span: [240, 36], b: 22 },
  { lang: 'ZH', y: 114, a: 44, span: [214, 30], b: 52 },
];
---
<svg viewBox="0 0 320 200" role="img" aria-label="Illustration: a picture and a model's answers about it in English, French, Italian and Chinese, with one hallucinated span flagged in each">
  <rect x="16" y="30" width="100" height="100" rx="10" class="s-surf"/>
  <path d="M26 118 L54 80 L72 102 L86 86 L106 118 Z" class="s-cool"/>
  <circle cx="92" cy="54" r="9" class="s-acc"/>
  {rows.map((r) => (
    <g>
      <rect x="128" y={r.y} width="26" height="16" rx="4" class="s-surf"/>
      <text x="141" y={r.y + 12} text-anchor="middle" font-size="9" class="s-muted">{r.lang}</text>
      <rect x="160" y={r.y + 5} width={r.a} height="6" rx="3" class="s-line"/>
      <rect x={r.span[0]} y={r.y + 2} width={r.span[1]} height="12" rx="3" class="s-accs k-acc" stroke-width="1.2"/>
      <rect x={r.span[0] + r.span[1] + 4} y={r.y + 5} width={r.b} height="6" rx="3" class="s-line"/>
    </g>
  ))}
  <text x="160" y="172" text-anchor="middle" font-size="11" class="s-muted">span + category · 4 languages</text>
</svg>
