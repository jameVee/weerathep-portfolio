---
// Project: GridWorld treasure collection — the agent's optimal path past treasures.
const cols = 5, rows = 4, size = 30, x0 = 85, y0 = 18;
const cells = Array.from({ length: cols * rows }, (_, i) => ({ c: i % cols, r: Math.floor(i / cols) }));
const treasures = [[3, 0], [1, 1], [4, 2]];
const cx = (c: number) => x0 + size / 2 + c * size;
const cy = (r: number) => y0 + size / 2 + r * size;
const path = [[0, 3], [1, 3], [1, 1], [3, 1], [3, 0]];
---
<svg viewBox="0 0 320 200" role="img" aria-label="Illustration: a grid world where an agent follows a path that collects treasures">
  {cells.map(({ c, r }) => (
    <rect x={x0 + c * size + 2} y={y0 + r * size + 2} width={size - 4} height={size - 4} rx="4" class="s-surf"/>
  ))}
  {treasures.map(([c, r]) => (
    <rect x={cx(c) - 7} y={cy(r) - 7} width="14" height="14" rx="3" class="s-acc"/>
  ))}
  <path d={path.map(([c, r], i) => `${i ? 'L' : 'M'}${cx(c)} ${cy(r)}`).join(' ')} fill="none" class="k-cool" stroke-width="2" stroke-dasharray="4 4" stroke-linecap="round"/>
  <circle cx={cx(0)} cy={cy(3)} r="8" class="s-cool"/>
  <text x="160" y="172" text-anchor="middle" font-size="11" class="s-muted">optimal policy · backpack capacity</text>
</svg>
