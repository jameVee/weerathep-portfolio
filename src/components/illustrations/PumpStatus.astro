---
// Project: Pump It Up — classify each water pump into one of three statuses.
const classes = [
  { label: 'functional', y: 40, dot: 's-cool' },
  { label: 'needs repair', y: 82, dot: 's-acc' },
  { label: 'non functional', y: 124, dot: 's-muted' },
];
---
<svg viewBox="0 0 320 200" role="img" aria-label="Illustration: a water pump with arrows to three status classes: functional, needs repair, non functional">
  <rect x="34" y="128" width="78" height="12" rx="4" class="s-line"/>
  <rect x="64" y="56" width="16" height="74" rx="4" class="s-cool"/>
  <path d="M80 72 H104 V88" fill="none" class="k-cool" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M66 62 L38 44" class="k-muted" stroke-width="5" stroke-linecap="round"/>
  <path d="M104 98 c-4 6 -4 9 0 10 c4 -1 4 -4 0 -10Z" class="s-acc"/>
  {classes.map((k) => (
    <g>
      <path d={`M120 94 C 138 94, 136 ${k.y + 13}, 152 ${k.y + 13}`} fill="none" class="k-line" stroke-width="1.5"/>
      <rect x="154" y={k.y} width="140" height="26" rx="13" class="s-surf k-line" stroke-width="1"/>
      <circle cx="170" cy={k.y + 13} r="5" class={k.dot}/>
      <text x="182" y={k.y + 17} font-size="11" class="s-ink">{k.label}</text>
    </g>
  ))}
  <text x="160" y="182" text-anchor="middle" font-size="11" class="s-muted">predict pump status from metadata</text>
</svg>
