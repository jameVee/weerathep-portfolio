---
// Hero: dotted Bangkok → Moscow route.
const dots = Array.from({ length: 14 }, (_, i) => 20 + i * 24);
---
<svg viewBox="0 0 360 220" role="img" aria-hidden="true">
  <g class="s-line">
    {dots.map((x) => <circle cx={x} cy="20" r="1.4" />)}
    {dots.map((x) => <circle cx={x} cy="200" r="1.4" />)}
  </g>
  <path d="M290 168 C 250 60, 140 40, 64 62" fill="none" class="k-acc" stroke-width="2.5" stroke-dasharray="2 7" stroke-linecap="round"/>
  <circle cx="290" cy="168" r="9" class="s-accs"/><circle cx="290" cy="168" r="5" class="s-acc"/>
  <circle cx="64" cy="62" r="9" class="s-accs"/><circle cx="64" cy="62" r="5" class="s-ink"/>
  <text x="290" y="194" text-anchor="middle" font-size="11" class="s-muted">13.85°N 100.57°E</text>
  <text x="64" y="42" text-anchor="middle" font-size="11" class="s-muted">55.70°N 37.36°E</text>
  <text x="196" y="88" text-anchor="middle" font-size="12" class="s-ink">≈ 7,070 km</text>
</svg>
