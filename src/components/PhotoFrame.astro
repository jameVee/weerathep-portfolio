---
/**
 * Hero photo. Drop your picture at src/assets/me.jpg (or .jpeg / .png / .webp).
 * If no file is there, the "Your photo here" placeholder is shown instead.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../lib/site';

const found = import.meta.glob<ImageMetadata>('../assets/me.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});
const photo = Object.values(found)[0];
---
<figure class="photo">
  <div class="pic">
    {photo ? (
      <Image
        src={photo}
        alt={`Portrait of ${SITE.name}`}
        widths={[320, 480, 640, 800, 960].filter((w) => w <= photo.width)}
        sizes="(max-width: 900px) calc(100vw - 120px), 360px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <div class="empty">
        <svg viewBox="0 0 72 72" aria-hidden="true">
          <circle cx="36" cy="27" r="13" class="s-line" />
          <path d="M12 66c2-14 12-21 24-21s22 7 24 21Z" class="s-line" />
        </svg>
        <span class="eyebrow">Your photo here</span>
      </div>
    )}
  </div>
</figure>
