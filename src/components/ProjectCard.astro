---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/site';
import Art from './illustrations/Art.astro';
import Chips from './Chips.astro';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;
---
<article class="proj tone" data-accent={d.accent} data-cool={d.cool}>
  <Art
    class="art"
    illustration={d.illustration}
    image={d.image}
    imageAlt={d.imageAlt}
    widths={[360, 540, 720, 960]}
    sizes="(max-width: 900px) calc(100vw - 40px), 340px"
  />
  <div class="body">
    <h3><a href={url(`projects/${project.id}/`)}>{d.title}</a></h3>
    <p>{d.summary}</p>
    {d.highlight && <p class="hl">{d.highlight}</p>}
    <Chips tags={d.tags} />
    <span class="more" aria-hidden="true">View project <span class="arr">→</span></span>
  </div>
</article>
